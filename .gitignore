# Build products. *.exe covers goc.exe / goa.exe and every compiled example on
# Windows; Linux ELF output has no suffix and is ignored per-directory below.
*.exe
.cache/
*.out
*.o
*.s

# Toolchain binaries (goc, goa, elfcheck, msgboxcheck) all land in bin/.
# NOTE: never ignore /goc or /src at the root -- src/ is now the compiler
# source tree and would be swallowed by such a pattern.
/bin/

# src/examples/ keeps only the .c sources; everything else there is a build
# product: src/examples/*.asm (goc -S output) and src/examples/foo (Linux ELF).
# Test runs use `goc -o bin/goc-out` so this rule is a safety net for
# hand-invoked `goc -S`/`goc -c` runs that write next to the source.
src/examples/*
!src/examples/*.c

# goclib/*.asm is embedded into goc with go:embed and must stay in the
# repository -- it is source, not a build product.

# Local agent workspace, not part of the project.
.workbuddy/

# Ad-hoc build artifacts and local scratch space from debugging sessions.
goclib_out.bin
scratch/

# Go build cache written next to the project when GOCACHE points here.
.gocache/

# Test/debug scratch dirs produced by goc runs (goa work areas).
tmp/
buildtmp/
